{
	/* 
	   Default: "§7{name}: {message}"
	   Controls how player names and messages are displayed in chat.
	   
	   Other players who join your server will be updated on what you set this to.
	   
	   Available variables:
	   {name} - The player's name
	   {message} - The player's message
	   
	   You can apply Minecraft text formatting by typing §<formatting character>,
	   which makes anything text after it have that formatting.
	   A complete list of color/formatting codes can be found here: https://minecraft.fandom.com/wiki/Formatting_codes.
	   
	   Styling is not applied to the {message} section - only the name and other characters in the format string are affected.
	   When a player is assigned to a team, the team color will override the config's name formatting.
	   
	   Examples:
	   "§7<§f{name}§7> {message}"
	   "§8[§f{name}§8] {message}"
	   "{name} §7>> {message}"
	*/
	"playerMessageFormat": "{name}: {message}",
	/* 
	   Default: OPERATORS_ONLY
	   Which players are allowed to use @everyone in chat.
	   
	   Available choices:
	   EVERYONE
	   OPERATORS_ONLY
	   NOBODY
	*/
	"atEveryonePermission": "OPERATORS_ONLY",
	/* 
	   Image configuration values that represent data sizes use KiB.
	   1 KiB, or a kibibyte, is equivalent to 1024 bytes, unlike a kilobyte which is only 1000 bytes. (they're basically the same, so you can just use kilobytes as reference)
	*/
	"images": {
		/* 
		   Default: true
		   Whether players can send images in chat or not on your server.
		*/
		"allowImages": true,
		/* 
		   Default: 10
		   Maximum amount of images that can be attached to a message. Values above 32 are capped at 32.
		*/
		"maxMessageImages": 10,
		/* 
		   Default: true
		   Whether to delete a player's stored chat images when they leave the server.
		   
		   This prevents old images from continuing to count toward the player's server storage limit after they rejoin,
		   since their client will no longer have access to those old messages to delete them.
		   
		   Enabling this also frees the server memory used to store those images.
		*/
		"deletePlayerImagesOnQuitting": true,
		/* 
		   Default: 8192
		   Messages with images above this size received by the server will be rejected.
		   Set to 0 or less to remove the configurable cap. A 64 MiB protocol safety limit still applies.
		*/
		"maxImageSizeKiB": 8192,
		/* 
		   Default: 25600
		   Limits the total server-stored chat image data per player.
		   Set to 0 or less to remove cap.
		*/
		"maxServerStoredPerPlayerImageDataKiB": 25600,
		/* 
		   Default: 3072
		   Images larger than this target will be progressively compressed and, if necessary, resized until they fit within the target size.
		   
		   If an image cannot be reduced enough within the allowed compression and resizing limits, it will be rejected.
		   This helps reduce the amount of RAM used for server-side image storage.
		   Set to 0 or less to disable full image compression.
		*/
		"imageCompressionTargetKiB": 3072
	}
}